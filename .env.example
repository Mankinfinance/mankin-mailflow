# ============================================================================
# Mankin Finance Lead Follow-up · environment template
# ============================================================================
# Copy this file to web/.env.local and fill in values as integrations come
# online. The full step-by-step is in docs/DEPLOYMENT.md.
#
# Defaults below run the app in fully mocked mode — every external service
# is stubbed. Flip a MOCK_* toggle to false ONLY after filling in the
# corresponding real credentials, or the app throws a clear runtime error.
# ============================================================================

# --- Auth.js signing secret ----------------------------------------------
# Random 256-bit secret signing broker SSO sessions AND portal JWTs.
# Generate one for every environment (dev / preview / prod) — never reuse.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Mock toggles --------------------------------------------------------
# Default all-true gives a fully clickable demo without credentials.
# Flip individually as you wire each provider. See docs/DEPLOYMENT.md.
SKIP_AUTH="true"
MOCK_SALESTREKKER="true"
MOCK_OTP="true"
MOCK_UPLOAD="true"
MOCK_CHAT="true"
MOCK_DB="true"

# --- Public base URL -----------------------------------------------------
# Used in portal links sent to customers. Localhost for dev,
# https://portal.mankinfinance.com.au (or your Vercel URL) for prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Microsoft Entra ID (broker SSO + Outlook live send) -----------------
# Single-tenant app registration, separate from the Graph upload one.
# Step 3 in docs/DEPLOYMENT.md.
#
# For live email send via Microsoft Graph /me/sendMail the app
# registration needs the following delegated permissions:
#   - openid / profile / email / User.Read (SSO basics)
#   - Mail.Send                       (compose + send via Outlook)
#   - offline_access                  (refresh tokens, ~90 day TTL)
#   - Mail.Read       OPTIONAL        (read inbox for future lead capture)
# Admin consent is recommended so brokers don't see the consent prompt
# on first sign-in.
#
# Set MOCK_OUTLOOK_SEND="true" to disable real send and log to console.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
MOCK_OUTLOOK_SEND="true"
MAIL_READ_SCOPE="false"

# --- Supabase Postgres (audit + portal tokens + chat transcripts) --------
# AU-region project. Step 2 in docs/DEPLOYMENT.md.
DATABASE_URL=""

# --- Microsoft Graph (SharePoint document uploads) -----------------------
# Separate app registration from the SSO one. Files.ReadWrite.All +
# Sites.ReadWrite.All application permissions, admin-consented.
# Step 4 in docs/DEPLOYMENT.md, full guide in docs/sharepoint-setup.md.
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
# Resolve via:
#   GET https://graph.microsoft.com/v1.0/shares/<base64-encoded-sharing-link>/driveItem
# Returns parentReference.driveId — paste it here.
SHAREPOINT_DRIVE_ID=""

# --- Salestrekker (CRM, system of record) --------------------------------
# Per-broker API key. Step 7 in docs/DEPLOYMENT.md.
# Gated on aggregator meeting — see docs/aggregator-pack/.
SALESTREKKER_API_KEY=""

# --- SMS Broadcast (customer OTPs + broker outbound SMS chases) ---------
# Cheaper Australian alternative to ClickSend (~4c vs ~7c per SMS).
# Sign up at https://www.smsbroadcast.com.au and grab the API password
# from your account settings.
SMS_BROADCAST_USERNAME=""
SMS_BROADCAST_PASSWORD=""
# Alpha sender ID (max 11 chars) shown as the "from" on the customer's
# phone. e.g. "Mankin" or "MankinFin".
SMS_BROADCAST_SENDER_ID="Mankin"
# Set MOCK_SMS="false" once the three above are filled in to enable
# real SMS dispatch. Until then, sends log to console only.
MOCK_SMS="true"

# --- Anthropic Claude (portal chat assistant) ----------------------------
# Step 6 in docs/DEPLOYMENT.md. Haiku 4.5 model — see lib/clients/claude.ts.
ANTHROPIC_API_KEY=""

# --- Webhook receiver shared secret --------------------------------------
# Required when Power Automate is live. Sent as x-mankin-webhook-secret
# header on every POST to /api/webhooks/salestrekker/*.
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# See docs/power-automate/00-connectors.md.
WEBHOOK_SHARED_SECRET=""

# --- Cron authentication -------------------------------------------------
# Shared secret every scheduled route checks before doing any work.
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>"
# on each cron invocation once the variable exists in the project.
#
# Every cron route fails CLOSED: with this unset, all of them return 401
# and no scheduled work runs at all. That is deliberate — api/cron/ is
# excluded from the Auth.js proxy, so this secret is the only gate, and
# /api/cron/campaigns sends real email to the back-book.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# --- Mailflow (campaigns, automations, forms) ----------------------------
# The marketing module. It has no mock toggle of its own — it sends
# through the same Outlook path as everything else, so MOCK_OUTLOOK_SEND
# governs whether a campaign actually leaves the building.
#
# Optional postal address printed in the campaign footer. The broker
# signature already carries name, phone, email and the ACR / ACL credit
# lines; this adds a street address on top. Left empty the line is
# omitted rather than guessed.
CAMPAIGN_POSTAL_ADDRESS=""
#
# Optional mailbox added to the List-Unsubscribe header alongside the
# one-click URL, so a mail client that prefers mail-to unsubscribe has
# somewhere to send it. Anything arriving here must be actioned the same
# day — see docs/deliverability.md.
CAMPAIGN_UNSUBSCRIBE_MAILTO=""
